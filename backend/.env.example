# ---------------------------------------------------------------------------
# Backend configuration. Copy to .env and fill in real values.
# Never commit the populated .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# PostgreSQL connection string. On Neon, use the direct URL (host without
# "-pooler") so migrations can run. connect_timeout gives slow first
# connections (a far-away region, or Neon waking from sleep) time to open.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require&connect_timeout=15

# JWT signing key. Must be at least 32 characters in production.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Public storefront address, used for links in emails.
APP_URL=http://localhost:5173

# SMTP credentials. Mail delivery is skipped when these are absent.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Razorpay keys. Online payment endpoints are disabled when absent.
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=

# Local AI (free, runs on this server): search by meaning and by photo.
# Models (~175 MB) download once into backend/.cache; run `npm run ai:download` to fetch them ahead of time.
# Set to off on very small servers.
AI_FEATURES=on

# Google sign-in (free). Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your site under
# "Authorized JavaScript origins" (e.g. http://localhost:5173). Leave empty to hide the button.
GOOGLE_CLIENT_ID=
